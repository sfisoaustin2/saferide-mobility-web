{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/src/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/src/admin.html"
    },
    {
      "source": "/verify",
      "destination": "/src/verify.html"
    },
    {
      "source": "/legal",
      "destination": "/src/legal.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/src/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/(admin|admin\\.html|src/admin\\.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}